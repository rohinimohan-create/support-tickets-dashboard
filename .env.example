# Copy to .env for local development (never commit .env)

PORT=8080
JIRA_BASE_URL=https://jira.unity3d.com
PROJECT_KEY=CSOP

# Unity Jira: use bearer + Personal Access Token (basic auth is disabled)
AUTH_MODE=bearer
JIRA_API_TOKEN=

# Only if your Jira instance supports basic auth (not Unity jira.unity3d.com)
# JIRA_EMAIL=you@unity3d.com
